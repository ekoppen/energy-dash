# Kopieer naar .env en vul in. .env staat in .gitignore — NOOIT committen.
# Bij Coolify: zet deze als environment variables / secrets in de UI.

# --- Home Assistant ---
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=plak-hier-je-long-lived-access-token

# --- Tarieven (Coolblue contract) ---
TARIEF_PIEK=0.254390
TARIEF_DAL=0.233699
TARIEF_TERUGLEVERING=0.060000

# --- Netwerk / poorten ---
# Origin(s) die de backend mag aanroepen (frontend-URL). Komma-gescheiden.
CORS_ORIGINS=http://localhost:8080
# Host-poort waarop de frontend bereikbaar is.
FRONTEND_PORT=8080
